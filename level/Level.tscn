[node name="note" parent="." unique_id=1083689497 instance=ExtResource("38_06nnm")]
transform = Transform3D(0.004232527, 0.031570144, -0.46891943, 0.06230961, 0.46476114, 0.031852607, 0.46583214, -0.0624532, -2.0605523e-08, 23.818947, 1.3682584, 42.8664)
des = "Dear dweeb Gwen,\\nwhy the hell do you keep changing your office password!? I tried to send you my report 3 times this week and the password you gave me didn't work!"

[node name="note2" parent="." unique_id=910795795 instance=ExtResource("38_06nnm")]
transform = Transform3D(0.11103497, 0.456696, 1.5109325e-08, 2.0544354e-08, -2.0544352e-08, 0.47000003, 0.456696, -0.11103497, -2.4816314e-08, 33.400116, 1.1117386, 46.315956)
des = "Whoever design this thing should be charged with a crime. \"Walkie-talkie\" implied it's a two-way communication devices, and this thing clearly doesn't do that. So I built a program to do so. Just connect the walkie-talkie to my computer and type whatever you want to send back."

[node name="note3" parent="." unique_id=900047690 instance=ExtResource("38_06nnm")]
transform = Transform3D(-2.0544352e-08, -0.040963203, -0.46821162, 0, 0.4682116, -0.040963203, 0.47, -1.7905585e-09, -2.046618e-08, -32.40478, 2.5566616, 29.835487)
des = "The snow view really is beautiful. Too bad I have to ruin the white plain, since this place doesn't have a toilet."

[node name="note4" parent="." unique_id=1899261605 instance=ExtResource("38_06nnm")]
transform = Transform3D(-3.4969112e-08, -0.06972458, 0.79695576, 0, 0.79695576, 0.06972458, -0.8, 3.047758e-09, -3.4836045e-08, -25.38909, 1.3206564, 25.403229)
des = "My god, you're dumb. I told you the password and figured you'd be able to connect the dots. It's the current day and month. Is it really that hard, doofus? It's only 4 digits."

[node name="note5" parent="." unique_id=2049788622 instance=ExtResource("38_06nnm")]
transform = Transform3D(2, 0, 0, 0, 2, 0, 0, 0, 2, 74.94675, 2.2718403, 41.969364)
des = "The place is currently in disarray. If you're inexperience, or it's lights out then please don't enter or you risk getting lost."

[node name="note6" parent="." unique_id=383135134 instance=ExtResource("38_06nnm")]
transform = Transform3D(0.47, 0, 0, 0, 0.46821153, -0.040963195, 0, 0.040963195, 0.46821153, 68.43218, 1.3668171, 41.34899)
des = "Man, that bear cause such a mess in here. How did it even walk in this deep before crashing out, or heck before anyone spot it. Good thing Max was able to handle it. Still, it is going to take a while before we get this place back in order."

[node name="note7" parent="." unique_id=2063733807 instance=ExtResource("38_06nnm")]
transform = Transform3D(1, 0, 0, 0, 0.9961947, -0.08715574, 0, 0.08715574, 0.9961947, -2.1413949, 1.6174853, 76.26364)
des = "A new policy has been enforced. We'll lock the master keycard, our only way to exit, in this room until we can prove our theory. This is to ensure the progress of the research and because we also need to send results back to Main. So hurry along. Food and other facilities will still be provided. Pardon the inconvenience.\\n                    Head of the research station.\\n\\n                              Dr. Villgie."

[node name="friged" parent="." unique_id=815102506 instance=ExtResource("39_6p8mh")]
transform = Transform3D(-4.371139e-08, 0, -1, 0, 1, 0, 1, 0, -4.371139e-08, 5.17853, -0.040196896, 75.32635)

[node name="friged2" parent="." unique_id=948419813 instance=ExtResource("39_6p8mh")]
transform = Transform3D(-4.371139e-08, 0, -1, 0, 1, 0, 1, 0, -4.371139e-08, 5.17853, -0.040196896, 73.67207)

[node name="keypad" parent="." unique_id=712850806 instance=ExtResource("39_7qksc")]
transform = Transform3D(-1.2020632e-08, 0, -0.3, 0, 0.3, 0, 0.275, 0, -1.3113417e-08, 23.821402, 1.3545203, 43.416267)

[node name="note8" parent="." unique_id=1161651468 instance=ExtResource("38_06nnm")]
transform = Transform3D(0.71544933, -0.18902987, 8.2627585e-09, 0, -3.2346428e-08, -0.74, 0.18902987, 0.71544933, -3.127328e-08, 4.522203, 1.0766678, 69.36693)
des = "Experiment log #1\\nRESULT: INCONCLUSIVE\\n\\nSpecies: Emperor Penguin\\nStare cycles: 2\\nHead tilt from magnetic north: 15 Degrees\\nCosmic ray interference: Present\\nPenguin present: Yes (obviously)\\n\\nNotes: Rupture reading barely moved. Subject looked more confused than committed. We have underestimated the required intensity. Try longer, and steeper.\\n\\n                                    Dr. Psychoboss"

[node name="note14" parent="." unique_id=1683919573 instance=ExtResource("38_06nnm")]
transform = Transform3D(0.34569094, 0.05475207, 0, -0.054543722, 0.3443755, -0.03050451, -0.0047719567, 0.030128948, 0.3486682, -1.629507, 1.3989995, 76.28805)
des = "Observation log #29\\n\\nWitness: Z'scare\\n\"Out, I want out! Let me out of this lab!!!!\""

[node name="note9" parent="." unique_id=2010565023 instance=ExtResource("38_06nnm")]
transform = Transform3D(-0.17274953, 0.71955377, 8.2627585e-09, 2.8480297e-08, 1.5335058e-08, -0.74, -0.71955377, -0.17274953, -3.127328e-08, 5.1320496, 1.077, 69.52207)
des = "Experiment log #78\\nRESULT: OVERLY SUCCESSFUL\\n\\nSpecies: Emperor Penguin\\nStare cycles: 44\\nHead tilt from magnetic north: 75 Degrees\\nCosmic ray interference: Absent\\nPenguin present: Yes\\n\\nNotes: Rupture achieved. Then some. Break room briefly existed across three different Tuesdays. HR has been notified.\\nPS. Rupture keep going over 3 week now. We might have done something irreversible at this station.\\n\\n                                    Dr. Psychoboss"

[node name="note10" parent="." unique_id=263868887 instance=ExtResource("38_06nnm")]
transform = Transform3D(0.74, 0, 0, 0, 0.7371841, 0.06449524, 0, -0.06449524, 0.7371841, 5.0130897, 1.3647963, 68.79293)
des = "Experiment log #45\\nRESULT: Nothing\\n\\nSpecies: -\\nStare cycles: 0\\nHead tilt from magnetic north: 0 Degrees\\nCosmic ray interference: Present\\nPenguin present: No\\n\\nNotes: I don't know what I was thinking. Maybe it's not the penguin, maybe we need to try something different. Who knows!\\n\\n                                  I am not signing"

[node name="note11" parent="." unique_id=2066443603 instance=ExtResource("38_06nnm")]
transform = Transform3D(0.49240386, 0.05122621, 0, 3.7952015e-09, -1.26989566e-08, -0.5, -0.08682409, 0.29051825, -2.1855694e-08, 1.7485584, 1.0856082, 69.50787)
des = "Observation log #1\\n\\nWitness: Dr. Animo\\n\"I swear I saw it. I saw the Titanic ship appear, clashing into the iceberg before my eyes, then it's gone. .... Huh? What do you mean it wasn't clash at Antarctica. Where else would there be an iceberg.\""

[node name="note17" parent="." unique_id=1091183248 instance=ExtResource("38_06nnm")]
transform = Transform3D(0.5908847, 0.061471462, -4.5542423e-09, 0, -1.5473832e-08, -0.6, -0.10418892, 0.34862193, -2.5828388e-08, 1.981247, 0.98967457, 75.17962)
des = "Observation log #9\\n\\nWitness: Dr. Villgie\\n\"1 Emperor Penguin stare 90 degrees up. There's no doubt about it.\""

[node name="note18" parent="." unique_id=550414896 instance=ExtResource("38_06nnm")]
transform = Transform3D(-0.19857392, 0.27057266, 0.016014587, 0, 0.01029535, -0.49969542, -0.4588773, -0.11708723, -0.00693013, 1.7727499, 1.0047988, 75.17962)
des = "Observation log #10\\n\\nWitness: Ben\\n\"I think you meant half that, Villgie. Have you tried looking up 90 degrees. How would that work.\""

[node name="note15" parent="." unique_id=1884790210 instance=ExtResource("38_06nnm")]
transform = Transform3D(0.42169568, 0.15850337, -3.7952015e-09, 8.363812e-09, -1.1913294e-08, -0.5, -0.2686498, 0.24880043, -2.1523656e-08, 2.228112, 1.0856082, 69.68196)
des = "Observation log #5\\n\\nWitness: Cooper\\n\"One penguin. Just the one. Sat there for twenty minutes without blinking while I was drinking a beer. I named him Michael.\""

[node name="note16" parent="." unique_id=199134073 instance=ExtResource("38_06nnm")]
transform = Transform3D(-2.1855692e-08, 0.025710938, 0.49809736, 0, 0.2938774, -0.04357787, -0.49999994, -1.1238609e-09, -2.1772527e-08, 5.1733737, 1.7968266, 73.33298)
des = "Observation log #3\\n\\nWitness: Dr. Animo\\n\"I saw 18 Fiordland penguins standing in circle staring at the center for 23 cycles like a cult! They must be summoning the rupture. We have to stop them now!\""

[node name="note12" parent="." unique_id=526534581 instance=ExtResource("38_06nnm")]
transform = Transform3D(0.54597676, -0.14680141, -4.554242e-09, -1.48550425e-08, -1.2752389e-08, -0.6, 0.24881595, 0.32212627, -2.5828388e-08, 2.031878, 1.0856082, 69.220474)
des = "Observation log #25\\n\\nWitness: Kevin\\n\"Why would a coffee machine make meat flavor smoothies. Who even drink that? It's a baby meal.\""

[node name="note19" parent="." unique_id=118410937 instance=ExtResource("38_06nnm")]
transform = Transform3D(0.365, 0, 0, 0, 0.2978622, 0.05229344, 0, -0.026059562, 0.59771687, 1.6330173, 0.9147241, 69.91894)
des = "Observation log #2\\n\\nWitness: Rook\\n\"I see a rupture happened while I was cleaning the glass. It was brief. But I am sure that there is no Cosmic rays reading at that time. Which is why it's surprising to see a rupture.\""

